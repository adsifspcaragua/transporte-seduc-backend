APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
SCRIBE_BASE_URL=http://127.0.0.1:8000
SCRIBE_TRY_IT_OUT_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=transporte
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:3000,127.0.0.1:5173,::1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em desenvolvimento os e-mails vao para o Mailpit (receptor local gratuito):
# SMTP em 127.0.0.1:1025 e caixa de entrada em http://127.0.0.1:8025.
# Sem o Mailpit rodando, use MAIL_MAILER=log para gravar os e-mails no log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="transporte@seduc.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Presenca por QR Code + dispositivo autorizado (ver ROADMAP.md, secao 18).
# Valores provisorios: dependem das decisoes D01-D10 com o PO e do piloto.
# PRESENCA_QR_URL=                          # padrao: FRONTEND_URL/presenca/scan
# Horarios das linhas sao locais; a aplicacao roda em UTC (config/app.php).
PRESENCA_FUSO=America/Sao_Paulo
PRESENCA_JANELA_ANTES_MIN=15
PRESENCA_JANELA_DEPOIS_MIN=15
PRESENCA_DESAFIO_SEGUNDOS=120
PRESENCA_APROVACAO_MINUTOS=30
PRESENCA_GEOCERCA_POLITICA=pontos
PRESENCA_PRECISAO_MAXIMA_METROS=100
PRESENCA_RAIO_MAXIMO_METROS=1000
# Vazio: nenhuma tentativa e apagada ate a politica de retencao (D10) existir.
PRESENCA_RETENCAO_TENTATIVAS_DIAS=

VITE_APP_NAME="${APP_NAME}"
